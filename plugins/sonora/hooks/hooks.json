    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/mgmtapi/scripts/profile.js\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/mgmtapi/scripts/write-gate.js\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
