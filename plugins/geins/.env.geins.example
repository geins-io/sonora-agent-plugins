# Credentials for the Geins Management API scripts under scripts/geins/.
# Copy this file to .env.geins and fill in the values, which come from an API User in
# Geins Merchant Center. .env.geins is gitignored; this template is not, so it stays empty.
#
# A copy at ~/.geins/.env is read too, and is the one to use if you want a single set of
# credentials shared across every git worktree. Real environment variables win over both files.

GEINS_MGMT_API_USER=
GEINS_MGMT_API_PWD=
GEINS_MGMT_API_KEY=

# More accounts: suffix every key with _<PROFILE>. Pick between them with /geins:profile, or pass
# --profile <profile> to the scripts. Run profile.js --list to see every profile it can find.
# GEINS_MGMT_API_USER_LABS=
# GEINS_MGMT_API_PWD_LABS=
# GEINS_MGMT_API_KEY_LABS=

# Force a profile without selecting one, for CI and plain shells.
# GEINS_MGMT_API_PROFILE=labs

# Point the scripts at a staging host or a local stub instead of https://mgmtapi.geins.io/API.
# GEINS_MGMT_API_BASEURL=
