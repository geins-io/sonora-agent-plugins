# Credentials for the Sonora Management API scripts under scripts/sonora/.
# Copy this file to .env.sonora and fill in the values, which come from an API User in
# Sonora Merchant Center. .env.sonora is gitignored; this template is not, so it stays empty.
#
# A copy at ~/.sonora/.env is read too, and is the one to use if you want a single set of
# credentials shared across every git worktree. Real environment variables win over both files.

SONORA_MGMT_API_USER=
SONORA_MGMT_API_PWD=
SONORA_MGMT_API_KEY=

# More accounts: suffix every key with _<PROFILE>. Pick between them with /sonora:profile, or pass
# --profile <profile> to the scripts. Run profile.js --list to see every profile it can find.
# SONORA_MGMT_API_USER_LABS=
# SONORA_MGMT_API_PWD_LABS=
# SONORA_MGMT_API_KEY_LABS=

# Force a profile without selecting one, for CI and plain shells.
# SONORA_MGMT_API_PROFILE=labs

# Point the scripts at a staging host or a local stub instead of https://mgmtapi.geins.io/API.
# SONORA_MGMT_API_BASEURL=
